# ==========================================
# Personal AI Voice Assistant Backend Environment
# ==========================================

# Application
PROJECT_NAME="Personal AI Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security (Generate secure random secrets in production: openssl rand -hex 32)
SECRET_KEY="change-me-to-a-super-secret-random-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration (PostgreSQL / Render)
# ==========================================
# If using Render PostgreSQL, paste your Render external/internal connection string below:
# Example Render URL: postgresql://assistant_user:password@dpg-xxxxx.oregon-postgres.render.com/assistant_db
# (The application automatically normalizes postgres:// or postgresql:// to postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_assistant_db

# Sync Database URL for Alembic Migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/personal_assistant_db

# ==========================================
# Redis Configuration (Session, Cache, Realtime Voice)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# ==========================================
# Voice Layer Configuration (Sarvam AI)
# ==========================================
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
SARVAM_API_KEY="your-sarvam-api-key-here"
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_STT_MODEL="saaras:v3"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="shubh"
SARVAM_LANGUAGE_CODE="en-IN"
SARVAM_TTS_PACE=1.0
SARVAM_TTS_PITCH=0.0
SARVAM_TTS_LOUDNESS=1.0
SARVAM_TTS_SAMPLE_RATE=16000
SARVAM_TTS_MAX_CHUNK_CHARS=500


# ==========================================
# LLM / AI Brain Layer (Gemini)
# ==========================================
LLM_PROVIDER=gemini
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30.0
